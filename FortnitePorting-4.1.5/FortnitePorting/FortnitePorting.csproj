<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>Assets/LogoRebrand.ico</ApplicationIcon>
        <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

        <!-- Memory tuning for a desktop app. Workstation GC (single heap, returns memory to the OS)
             instead of any Server-GC behavior, concurrent so the UI stays responsive. -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <!-- Aggressively decommit and hand freed segments back to the OS (1=light … 9=aggressive).
             Without this the .NET heap holds onto memory it has reclaimed internally, so RSS stays
             high after browsing assets even once the thumbnails are evicted. 7 leans toward low
             RSS at a small GC-CPU cost — the asset-browsing workload allocates in bursts (tab
             loads) and then idles, which is exactly the pattern this setting rewards. -->
        <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" Trim="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" />
        <PackageReference Include="Avalonia_Gif" />
        <PackageReference Include="AvaSourceGenerators" />
        <PackageReference Include="ConcurrentHashSet" />
        <PackageReference Include="DiscordRichPresence" />
        <PackageReference Include="DynamicData" />
        <PackageReference Include="EpicManifestParser" />
        <PackageReference Include="FFMpegCore" />
        <PackageReference Include="FluentAvaloniaUI" />
        <PackageReference Include="Mapster" />
        <PackageReference Include="Material.Icons.Avalonia" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="NodifyAvalonia" />
        <PackageReference Include="ReactiveUI" />
        <PackageReference Include="RestSharp" />
        <PackageReference Include="RestSharp.Serializers.NewtonsoftJson" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="Supabase" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" />
        <PackageReference Include="Tomlyn" />
        <PackageReference Include="z440.atl.core" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Dependencies\CUE4Parse\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
        <ProjectReference Include="..\Dependencies\CUE4Parse\CUE4Parse\CUE4Parse.csproj" />
        <ProjectReference Include="..\FortnitePorting.Plugins\FortnitePorting.Plugins.csproj" />
        <ProjectReference Include="..\FortnitePorting.Rendering\FortnitePorting.Rendering.csproj" />
        <ProjectReference Include="..\FortnitePorting.Shared\FortnitePorting.Shared.csproj" />
        <ProjectReference Include="..\Dependencies\FluentAvalonia.BreadcrumbBar\FluentAvalonia.BreadcrumbBar\FluentAvalonia.BreadcrumbBar.csproj" />
    </ItemGroup>
</Project>