<controls:FPStyles xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:FortnitePorting.Controls">
    <!--
        Tahoe — Apple "Liquid Glass" (macOS 26), dark mode.
        This is a DARK smoked-glass look, not clear glass: surfaces are dark and opaque
        enough to keep the light SF-style text crisp, while the AcrylicBlur backdrop and
        bright white specular rims give the glassy, luminous feel. The window frost is a
        dark tint so the wallpaper behind reads as frosted glass rather than washing text out.
        Accent is Apple system blue. Alpha (#AARRGGBB) controls how much blur frosts through.
    -->
    <controls:FPStyles.Resources>
        <!-- Bright glass hairline separators -->
        <Brush x:Key="FPSeparatorColorLayer1">#2EFFFFFF</Brush>
        <Brush x:Key="FPSeparatorColorLayer2">#1CFFFFFF</Brush>

        <!-- Glass controls: dark frosted fill, brighter on hover, bright specular rim -->
        <Brush x:Key="FPButtonBackground">#3A26262F</Brush>
        <Brush x:Key="FPButtonBackgroundPointerOver">#50353540</Brush>
        <Brush x:Key="FPButtonBackgroundPressed">#2C1F1F28</Brush>
        <Brush x:Key="FPButtonBorderBrush">#33FFFFFF</Brush>

        <!-- Secondary glass layer -->
        <Brush x:Key="FPLayer2">#30222229</Brush>
        <Brush x:Key="FPLayer2PointerOver">#442F2F38</Brush>
        <Brush x:Key="FPLayer2Pressed">#241D1D24</Brush>

        <!-- Selected = accent-tinted glass (Apple blue) -->
        <Brush x:Key="FPButtonBackgroundSelected">#500A84FF</Brush>
        <Brush x:Key="FPButtonBackgroundSelectedPointerOver">#631E90FF</Brush>

        <!-- Bright glass (prominent controls) -->
        <Brush x:Key="FPButtonBackgroundBright">#4C33333D</Brush>
        <Brush x:Key="FPButtonBackgroundBrightPointerOver">#5E3F3F49</Brush>

        <!-- Cards: dark frosted glass with a subtle brighter top edge (specular sheen). Dark
             enough to keep light card text/labels legible. -->
        <LinearGradientBrush x:Key="FPContentCardBackground" StartPoint="0%, 0%" EndPoint="0%, 100%">
            <GradientStops>
                <GradientStop Color="#4A2A2A33" Offset="0"/>
                <GradientStop Color="#3C1F1F27" Offset="1"/>
            </GradientStops>
        </LinearGradientBrush>

        <!-- Popovers sit over content, so a nearly opaque dark frosted glass -->
        <LinearGradientBrush x:Key="FPPopupContentCardBackground" StartPoint="0%, 0%" EndPoint="0%, 100%">
            <GradientStops>
                <GradientStop Color="#EC1F2027" Offset="0"/>
                <GradientStop Color="#E617181F" Offset="1"/>
            </GradientStops>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FPContentCardBackgroundBright" StartPoint="0%, 0%" EndPoint="0%, 100%">
            <GradientStops>
                <GradientStop Color="#5C31313B" Offset="0"/>
                <GradientStop Color="#4A26262E" Offset="1"/>
            </GradientStops>
        </LinearGradientBrush>

        <!-- SF-style label colors, nudged brighter for contrast over the frosted material -->
        <SolidColorBrush x:Key="TextFillPrimaryBrush" Color="#F7F7FA" />
        <SolidColorBrush x:Key="TextFillPrimaryDisabledBrush" Color="#80F7F7FA" />

        <SolidColorBrush x:Key="TextFillSecondaryBrush" Color="#BFBFC6" />
        <SolidColorBrush x:Key="TextFillSecondaryDisabledBrush" Color="#80BFBFC6" />

        <SolidColorBrush x:Key="TextFillTertiaryBrush" Color="#8E8E96" />
        <SolidColorBrush x:Key="TextFillTertiaryDisabledBrush" Color="#808E8E96" />

        <!-- Dark smoked-glass frost: the window/content are dark-tinted so the blurred
             wallpaper stays subtle and text keeps contrast, while still reading as glass. -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#8214141A" />
        <SolidColorBrush x:Key="ContentBorderBackgroundBrush" Color="#A614141A" />
        <SolidColorBrush x:Key="ContentBorderBorderBrush" Color="#24FFFFFF" />

        <SolidColorBrush x:Key="ContentBorderLayer2BackgroundBrush" Color="#8E16161C" />
        <SolidColorBrush x:Key="ContentBorderLayer2BorderBrush" Color="#1CFFFFFF" />

        <!-- Soft dark scrim for dialogs/broadcast -->
        <SolidColorBrush x:Key="DialogOverlayBackgroundBrush" Color="#B3000000" />
        <SolidColorBrush x:Key="BroadcastOverlayBackgroundBrush" Color="#B3000000" />

        <SolidColorBrush x:Key="FPTitleTextBrush" Color="#F7F7FA" />

        <!-- Apple system blue (dark) -->
        <Color x:Key="FPAccentColor">#0A84FF</Color>
        <SolidColorBrush x:Key="FPAccentBrush" Color="{DynamicResource FPAccentColor}" />

        <Bitmap x:Key="FPLogoBitmap">avares://FortnitePorting/Assets/LogoRebrand.png</Bitmap>

    </controls:FPStyles.Resources>

</controls:FPStyles>
